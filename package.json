{
  "name": "casker",
  "version": "1.0.0",
  "description": "A database backup CLI",
  "main": "./src/shared/presentation/bin/run.js",
  "scripts": {
    "test": "echo \"no tests yet\" && exit 0",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typeorm": "typeorm-ts-node-esm",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StenSOn27/casker.git"
  },
  "keywords": ["cli"],
  "preferGlobal": true,
  "author": "Taras Shevchyk(tarashevhik27@gmail.com)",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/StenSOn27/casker/issues"
  },
  "homepage": "https://github.com/StenSOn27/casker#readme",
  "dependencies": {
    "@oclif/core": "^5.1.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "columnify": "^1.6.0",
    "deep-equal": "^2.2.3",
    "dotenv": "^17.4.2",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "inquirer": "^14.2.2",
    "inquirer-file-selector": "^2.0.0",
    "inquirer-select-directory": "^1.2.0",
    "readline": "^1.3.0",
    "reflect-metadata": "^0.2.2",
    "shallow-equal-object": "^1.1.1",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2",
    "yargs": "^18.1.0"
  },
  "bin": {
    "casker": "./src/shared/presentation/bin/run.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "lodash-es": "^4.18.1",
    "oclif": "^6.0.2",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "**/*": ["eslint . --fix", "prettier --write --ignore-unknown"]
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "spawn-sync@1.0.15": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "oclif": {
    "bin": "casker",
    "dirname": "casker",
    "topicSeparator": " ",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/src/shared/composition/commands.js",
      "identifier": "COMMANDS"
    },
    "helpOptions": {
      "flagSortOrder": "none"
    },
    "hooks": {
      "init": ["./dist/src/shared/presentation/hooks/init/dataSourceInitialize"]
    }
  }
}
